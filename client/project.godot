; Arquivo de configuração do projeto Godot.

config_version=5

[application]

config/name="Goblo"
config/description="MMO cozy no planeta Terra de verdade — fase 1: o globo."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[goblo]

; URL do servidor do mundo. Também dá para trocar com GOBLO_SERVER_URL ou com
; "-- --server=http://..." na linha de comando.
server_url="http://127.0.0.1:8080"

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
